# Smart Campus Analytics - Environment Variables Configuration
FLASK_APP=backend.app
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=smart-campus-dev-secret-key-change-in-production-2026
DATABASE_URI=sqlite:///../database/smart_campus.db
TEST_DATABASE_URI=sqlite:///:memory:

# Institutional Scoring Defaults (Weights must sum to 1.0 or 100%)
WEIGHT_ACADEMIC=0.30
WEIGHT_ATTENDANCE=0.20
WEIGHT_LMS=0.10
WEIGHT_ENGAGEMENT=0.10
WEIGHT_PLACEMENT=0.15
WEIGHT_SKILLS=0.10
WEIGHT_FEEDBACK=0.05

# Attendance Thresholds (%)
ATTENDANCE_WARNING_THRESHOLD=75.0
ATTENDANCE_CRITICAL_THRESHOLD=65.0

# Risk Analysis Thresholds (0-100 scale)
RISK_HIGH_THRESHOLD=50.0
RISK_MEDIUM_THRESHOLD=75.0

# Google Gemini AI API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_RATE_LIMIT_PER_MINUTE=20

# MongoDB Atlas Database Configuration (Official MongoDB Driver / PyMongo)
# Option 1 (Recommended): Full Connection String from Atlas Dashboard
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/smart_campus_db?retryWrites=true&w=majority

# Demo Evaluator Configuration (Render & Local Evaluation)
DEMO_LOGIN_ENABLED=True
DEMO_ADMIN_USERNAME=demo_evaluator
# DEMO_ADMIN_PASSWORD is optional; if omitted, a cryptographically secure random password is generated and hashed
DEMO_ADMIN_PASSWORD=

